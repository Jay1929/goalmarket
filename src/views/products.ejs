<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <nav class="admin-navbar">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/admin/product/all">Products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item" onclick="return confirm('Do you want to logout?')">
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
      </ul>
    </nav>

    <main class="products-page-frame">
      <section class="admin-board">
        <div class="products-table-section">
          <div class="section-header">
            <div>
              <span class="section-kicker">GOALMARKET ADMIN</span>
              <h1 class="section-title">Football Shop Products</h1>
            </div>

            <div class="table-actions">
              <input
                type="text"
                class="product-search-input"
                placeholder="Search product..."
              />
              <button class="btn btn-primary" id="process-btn">New Product</button>
            </div>
          </div>

          <div class="table-card">
            <table class="table products-table table-hover">
              <thead>
                <tr>
                  <th scope="col">T/r</th>
                  <th scope="col">Product Name</th>
                  <th scope="col">Product Type</th>
                  <th scope="col">Product Size</th>
                  <th scope="col">Product Price</th>
                  <th scope="col">Product Left Count</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>

              <tbody>
                <% products.map(function(value, key) { %>
                <tr class="product-row">
                  <td><%= key + 1 %></td>
                  <td class="product-name-cell"><%= value.productName %></td>
                  <td><span class="type-badge"><%= value.productCollection %></span></td>
                  <td>
                    <%= Array.isArray(value.productSize) ? value.productSize.join(', ') : value.productSize %>
                  </td>
                  <td>$<%= value.productPrice %></td>
                  <td><%= value.productLeftCount %></td>
                  <td>
                    <select class="spec-select new-product-status" id="<%= value._id %>">
                      <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected' : '' %>>PAUSE</option>
                      <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                      <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                    </select>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <form
          onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="product-form-section"
          enctype="multipart/form-data"
        >
          <div class="form-header">
            <span class="section-kicker">CREATE PRODUCT</span>
            <h2 class="form-title">New Product Detail</h2>
          </div>

          <div class="long-input">
            <label>Product Name</label>
            <input
              type="text"
              placeholder="Name"
              name="productName"
              class="product-name"
            />
          </div>

          <input name="productStatus" value="PAUSE" class="product-status" hidden />

          <div class="half-input-frame">
            <div class="half-input">
              <label>Product Price</label>
              <input
                type="number"
                placeholder="Price"
                name="productPrice"
                class="product-price"
              />
            </div>

            <div class="half-input">
              <label>Product Left Count</label>
              <input
                type="number"
                placeholder="Count"
                name="productLeftCount"
                class="product-left-count"
              />
            </div>
          </div>

          <div class="half-input-frame">
            <div class="half-input">
              <label>Product Type</label>
              <select class="product-collection" name="productCollection">
                <option value="JERSEY" selected>Jersey</option>
                <option value="BOOTS">Boots</option>
                <option value="BALL">Ball</option>
                <option value="WINDBREAKER">Windbreaker</option>
                <option value="OTHER">Other</option>
              </select>
            </div>

            <div class="half-input">
              <label>Product Size</label>
              <input
                type="text"
                placeholder="Size"
                name="productSize"
                class="product-size"
              />
            </div>
          </div>

          <div class="long-input">
            <label>Product Description</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>

          <div class="img-frame">
            <label>Product Images</label>
            <div class="media-frame">
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="1" id="image-section-1" />
                <input
                  type="file"
                  name="productImages"
                  class="image-one file-input"
                  required
                  onchange="previewFileHandler(this, 1)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="2" id="image-section-2" />
                <input
                  type="file"
                  name="productImages"
                  class="image-two file-input"
                  onchange="previewFileHandler(this, 2)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="3" id="image-section-3" />
                <input
                  type="file"
                  name="productImages"
                  class="image-three file-input"
                  onchange="previewFileHandler(this, 3)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="4" id="image-section-4" />
                <input
                  type="file"
                  name="productImages"
                  class="image-four file-input"
                  onchange="previewFileHandler(this, 4)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="5" id="image-section-5" />
                <input
                  type="file"
                  name="productImages"
                  class="image-five file-input"
                  onchange="previewFileHandler(this, 5)"
                />
              </div>
            </div>
          </div>

          <div class="operation-buttons">
            <button type="button" class="btn btn-danger" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="create-btn">Create</button>
          </div>
        </form>
      </section>
    </main>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
