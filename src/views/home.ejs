<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body>
  <div class="home-container">
    <nav class="admin-navbar">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link active" href="/admin/">Dashboard</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin/product/all">Products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item" onclick="return confirm('Do you want to logout?')">
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
        <% } %>
      </ul>
    </nav>

    <main class="dashboard-frame">
      <section class="dashboard-info">
        <% if(member) { %>
          <span class="section-kicker">GOALMARKET ADMIN</span>
          <h1 class="dashboard-title">Football Shop Dashboard</h1>
          <!-- <p class="dashboard-text">Manage football products, users, and shop activity from one place.</p> -->
        <% } else { %>
          <span class="section-kicker">GOALMARKET</span>
          <h1 class="dashboard-title">Admin Portal</h1>
          <p class="dashboard-text">Please log in to manage products and users.</p>
        <% } %>
<!-- 
        <% if(member) { %>
        <div class="dashboard-actions">
          <a class="dashboard-btn primary" href="/admin/product/all">Manage Products</a>
          <a class="dashboard-btn secondary" href="/admin/user/all">Manage Users</a>
        </div>
        <% } %> -->
      </section>

