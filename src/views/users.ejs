<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="users-container">
    <% if(!member) { %>
    <nav class="admin-navbar">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
      </ul>
    </nav>

    <main class="users-page-frame">
      <section class="admin-board login-warning-card">Please login first!</section>
    </main>
    <% } else { %>
    <nav class="admin-navbar">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/product/all">Products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item" onclick="return confirm('Do you really want to logout?')">
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
      </ul>
    </nav>

    <main class="users-page-frame">
      <section class="admin-board">
        <div class="section-header">
          <div>
            <span class="section-kicker">GOALMARKET ADMIN</span>
            <h1 class="section-title">Shop Users</h1>
          </div>
        </div>

        <div class="table-card">
          <table class="table users-table table-hover">
            <thead>
              <tr>
                <th scope="col">No</th>
                <th scope="col">Name</th>
                <th scope="col">Phone</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              <% users.map(function (value, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="user-name-cell"><%= value.memberNick %></td>
                <td><%= value.memberPhone %></td>
                <td>
                  <select class="spec-select member-status" id="<%= value._id %>">
                    <option value="ACTIVE" <%= value.memberStatus === 'ACTIVE' ? 'selected': '' %>>ACTIVE</option>
                    <option value="BLOCK" <%= value.memberStatus === 'BLOCK' ? 'selected': '' %>>BLOCK</option>
                    <option value="DELETE" <%= value.memberStatus === 'DELETE' ? 'selected': '' %>>DELETE</option>
                  </select>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
    <% } %>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
